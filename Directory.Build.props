<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <Company>Secure Intake</Company>
    <Product>Secure Intake</Product>
    <!-- Experimental BCL APIs used deliberately: ML-KEM (SYSLIB5006). -->
    <NoWarn>$(NoWarn);SYSLIB5006;CA1716;CA1720;CA1711;CA1724;CA1848;CA1515;CA2007</NoWarn>
  </PropertyGroup>

  <!-- Every shipped (non-test) project must be AOT and trim clean. -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true' and $(MSBuildProjectDirectory.Contains('/src/'))">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;CA1861;CA2000;CA1859;CA1305;CA1062</NoWarn>
  </PropertyGroup>
</Project>
